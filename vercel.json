{
  "redirects": [
    { "source": "/downloads/Motor-XS-Windows.zip", "destination": "/downloads/Motor-WhatsApp-XS.zip", "permanent": false },
    { "source": "/downloads/Motor-XS.zip", "destination": "/downloads/Motor-WhatsApp-XS.zip", "permanent": false }
  ],
  "rewrites": [{ "source": "/((?!api/|downloads/).*)", "destination": "/index.html" }],
  "crons": [{ "path": "/api/keepalive", "schedule": "0 12 * * *" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
