# Deixe vazio para usar o modo local (dados salvos no navegador).
# Preencha para sincronizar com o Supabase (requer login).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Busca no Maps (api/maps.ts): chave do Google com a "Places API (New)" ativada.
# Só o servidor lê. NUNCA use o prefixo VITE_ (isso mandaria a chave para o navegador).
GOOGLE_PLACES_KEY=
