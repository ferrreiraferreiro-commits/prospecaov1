# Deixe vazio para usar o modo local (dados salvos no navegador).
# Preencha para sincronizar com o Supabase (requer login).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor de busca de empresas (busca/, na VPS). Só o servidor da Vercel lê.
# NUNCA use o prefixo VITE_ (isso mandaria a senha para o navegador).
XS_BUSCA_URL=
XS_BUSCA_TOKEN=

# Motor WhatsApp: "local" (padrão: Motor no computador de cada pessoa) ou "cloud" (Motor na VPS, whatsapp-cloud/).
# No modo cloud, só as contas liberadas na VPS (XS_CLOUD_USUARIOS) usam a nuvem; as outras continuam no Motor local.
# Para voltar ao que era: WHATSAPP_ENGINE=local (ou apague a variável) e publique de novo.
WHATSAPP_ENGINE=local
# Endereço do gateway na VPS (opcional; este é o padrão)
# WHATSAPP_ENGINE_URL=https://109-110-184-199.sslip.io/whatsapp
